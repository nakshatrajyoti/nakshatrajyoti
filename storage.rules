rules_version = '2';

// =========================================================
// NAKSHATRA JYOTI — Firebase Storage Security Rules
//
// Paste this into Firebase Console → Storage → Rules, and
// click Publish. Every upload in the app (poster photos,
// acharya photo, post cover photo/video, chat photo/video/
// file) is written to a single, consistent path pattern:
//   uploads/{uid}/{folder}/{file}
// where {uid} is always the currently signed-in user who
// performed the upload (see photo/video upload code in
// script.js — both write to `uploads/${user.uid}/...`).
// =========================================================

service firebase.storage {
  match /b/{bucket}/o {

    match /uploads/{uid}/{allPaths=**} {
      // Public read — posters, acharya photos, post media, and
      // chat attachments all need to render for whoever the
      // content is shown to (visitors, other chat participant,
      // etc). Firestore rules already gate who can see a
      // document that references a given file's URL.
      allow read: if true;

      // Only the owner can upload into their own uploads/{uid}/
      // folder, and only images/videos up to 60MB (matches the
      // client-side MAX_VIDEO_MB / crop-output limits).
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 60 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*'));

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}
