rules_version = '2';

// ============================================================
// Nakshatra Jyoti — Firebase Storage Security Rules
// Deploy: Firebase Console → Storage → Rules → paste → Publish
// या: firebase deploy --only storage
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Posters, Acharya profile photos, post cover photos, and post
    // videos all go through uploads/{uid}/{folder}/... — the same
    // pattern the app's reusable NJPhoto picker and video uploader
    // already use, so one rule covers all of them.
    match /uploads/{uid}/{allPaths=**} {
      allow read: if true; // ये images/videos public site पर दिखती हैं
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024; // 25MB सीमा
    }

    // Chat media: chat/{conversationId}/{senderUid}/...
    // Storage rules can cross-check Firestore directly (firestore.get),
    // so this now actually restricts access to the two real
    // participants of that conversation — not just "any logged-in
    // user" as before. If the conversation doc is ever deleted this
    // fails closed (get() on a missing doc denies), which is the
    // safe default.
    match /chat/{conversationId}/{senderUid}/{fileName} {
      allow read: if request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participantUids;

      allow write: if request.auth != null && request.auth.uid == senderUid &&
        request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participantUids &&
        request.resource.size < 50 * 1024 * 1024; // 50MB सीमा (video)
    }
  }
}
