rules_version = '2';

// ============================================================
// Nakshatra Jyoti — Firestore Security Rules
// यह पूरा project अभी तक जो collections असल में इस्तेमाल करता है
// (users, admins, acharyas, rashifal, posts + comments,
// conversations + messages, guidanceRequests, notifications,
// presence) उन सभी को cover करता है।
//
// Deploy: Firebase Console → Firestore Database → Rules → इस
// पूरी फ़ाइल की content paste करें → Publish।
// या CLI से: firebase deploy --only firestore:rules
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Acharya role check. Your acharyas/{id} document ids are
    // generated slugs, not the acharya's uid (see note in the
    // rashifal section below), so this checks the *role* stored
    // on the user's own users/{uid} doc instead — cheap and safe.
    function isAcharya() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "acharya";
    }

    // ---- USERS ----
    // हर user अपनी profile पढ़/लिख सकता है, Admin सबकी।
    // कोई भी client खुद को "role: admin/acharya" में upgrade न
    // कर सके, इसलिए role field सिर्फ़ तब बदल सकता है जब वो
    // पहले जैसा ही रहे (यानी client से role escalation संभव नहीं)।
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == uid &&
         request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // ---- ADMINS (role marker) ----
    // यह collection सिर्फ़ पढ़ने के लिए है (client role-check करता
    // है)। इसमें लिखना Firebase Console / Admin SDK से manually
    // होना चाहिए, client से कभी नहीं — इसलिए write हमेशा false है।
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- ACHARYAS (public profiles) ----
    // Admin manages everything (create/delete, assignedRashis,
    // active status, contact links). An Acharya may additionally
    // update ONLY their own doc (matched by resource.data.uid, not
    // the document id — see the rashifal note above) and ONLY the
    // self-service fields: photo, name, qualification, speciality,
    // bio. Anything else in the same write is rejected.
    match /acharyas/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["name", "qualification", "speciality", "bio", "image"])
      );
    }

    // ---- RASHIFAL ----
    // कोई भी logged-in user पढ़ सकता है। Admin हमेशा लिख सकता है;
    // कोई भी Acharya भी लिख सकता है — क्योंकि acharyas/{id} की id
    // uid नहीं है, per-sign "assignedRashis" का बारीक check अभी
    // rules स्तर पर संभव नहीं (client UI में locked/unlocked दिखता
    // है)। नीचे "अगला कदम" देखें कि इसे कैसे कड़ा किया जा सकता है।
    match /rashifal/{signId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAcharya();
    }

    // ---- POSTS / ACHARYA VICHAR (+ likes via likedBy array) ----
    match /posts/{postId} {
      allow read: if resource.data.published == true || isAdmin() ||
        (isSignedIn() && resource.data.authorUid == request.auth.uid);

      allow create: if isSignedIn() && (isAdmin() || isAcharya()) &&
        request.resource.data.authorUid == request.auth.uid;

      // Covers both normal edits AND the like toggle (likedBy/likeCount
      // change) — any signed-in user may toggle their own like, but
      // only the author/Admin may change everything else.
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.authorUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["likedBy", "likeCount", "commentCount"])
      );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      // ---- COMMENTS (subcollection) ----
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if false; // comments are not editable, only postable/deletable
        allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // ---- CONVERSATIONS (User ⇄ Acharya private chat) ----
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantUids;

      // Self-message is blocked here too, not just in the UI:
      // userId and acharyaUid can never be the same value.
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participantUids &&
        request.resource.data.userId != request.resource.data.acharyaUid;

      allow update: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;

        allow create: if isSignedIn() &&
          request.resource.data.senderUid == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantUids;

        // Only the sender (or Admin) may delete their own message.
        allow delete: if isAdmin() || (isSignedIn() && resource.data.senderUid == request.auth.uid);
        allow update: if false;
      }
    }

    // ---- GUIDANCE REQUESTS ----
    // User अपनी request बना सकता है और सिर्फ़ अपनी पढ़ सकता है।
    // Admin/Acharya सब पढ़/जवाब दे सकते हैं (per-category assigned
    // Acharya तक सीमित करना अभी client पर ही है, rules पर नहीं —
    // rashifal जैसी ही सीमा, नीचे "अगला कदम" देखें)।
    match /guidanceRequests/{id} {
      allow read: if isAdmin() || isAcharya() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isAcharya();
      allow delete: if isAdmin();
    }

    // ---- NOTIFICATIONS ----
    match /notifications/{id} {
      allow read: if isSignedIn() &&
        (resource.data.targetUid == request.auth.uid || resource.data.targetUid == "all" || isAdmin());

      // कोई भी logged-in user एक notification बना सकता है (नया
      // post / guidance जवाब जैसी events के लिए), लेकिन सिर्फ़
      // Admin "announcement" प्रकार भेज सकता है।
      allow create: if isSignedIn() &&
        (request.resource.data.type != "announcement" || isAdmin());

      // Marking as read: केवल अपना uid readBy array में जोड़ना।
      allow update: if isSignedIn() &&
        (resource.data.targetUid == request.auth.uid || resource.data.targetUid == "all" || isAdmin());

      allow delete: if isAdmin();
    }

    // ---- PRESENCE (online/offline heartbeat) ----
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}

// ============================================================
// अगला कदम (recommended, not done automatically):
// अभी acharyas/{id} की document id एक generated slug है, Firebase
// uid नहीं — इस वजह से ऊपर rashifal और guidanceRequests में
// "कौन सी specific राशि / category किस Acharya को assign है"
// वाला बारीक check rules स्तर पर संभव नहीं, सिर्फ़ "कोई भी
// Acharya" तक। अगर आप चाहें तो अगले step में acharyas/{uid}
// पर migrate करके इसे और कड़ा कर सकता हूँ — मौजूदा data को
// तोड़े बिना, एक deliberate, अलग से किया जाने वाला बदलाव।
// ============================================================
